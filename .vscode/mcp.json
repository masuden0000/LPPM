{
  "inputs": [
    {
      "type": "promptString",
      "id": "stitch-api-key-v2",
      "description": "Stitch API Key",
      "password": true
    }
  ],
  "servers": {
    "figma": {
      "url": "https://mcp.figma.com/mcp",
      "type": "http"
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "type": "http",
      "headers": {
        "Accept": "application/json",
        "X-Goog-Api-Key": "${input:stitch-api-key-v2}"
      }
    }
  }
}
